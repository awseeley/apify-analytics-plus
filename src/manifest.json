{
  "manifest_version": 3,
  "name": "Apify Analytics Plus",
  "version": "0.4.0",
  "description": "Per-Actor breakdowns for Apify Console Insights: daily revenue by Actor, plus per-Actor funnels and traffic changes on Acquisition.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Apify Analytics Plus",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.apify.com/*"
      ],
      "js": [
        "content/token-sniffer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://console.apify.com/*"
      ],
      "js": [
        "lib/format.js",
        "lib/api.js",
        "lib/cache.js",
        "lib/actor-meta.js",
        "content/app.js",
        "content/acquisition.js",
        "content/quality.js"
      ],
      "css": [
        "content/app.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
